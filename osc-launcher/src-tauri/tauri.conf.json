{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSC Launcher",
  "version": "1.1.0",
  "identifier": "com.sr2610.osclauncher",
  "build": {
    "beforeDevCommand": "node copy-ui.js",
    "beforeBuildCommand": "node copy-ui.js",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OSC Launcher",
        "width": 1280,
        "height": 780,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/app-icon.ico"
    ]
  }
}
