{
  "name": "osc-launcher",
  "version": "1.1.0",
  "description": "Listen for OSC and launch batch/EXE commands",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "dist": "electron-builder --win portable",
    "tauri": "npx @tauri-apps/cli",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "tauri:build:portable": "npx @tauri-apps/cli build --no-bundle"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "osc": "^2.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.sr2610.osclauncher",
    "productName": "OSC Launcher",
    "asar": true,
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "index.css",
      "renderer.js",
      "assets/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/test/**",
      "!**/tests/**",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**",
      "!node_modules/**/*.d.ts"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico",
      "artifactName": "OSCLauncher-${version}.exe",
      "compression": "maximum"
    },
    "portable": {
      "splashImage": null,
      "unpackDirName": "osc-launcher"
    }
  },
  "author": "",
  "license": "ISC"
}
